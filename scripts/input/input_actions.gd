class_name InputActions
extends RefCounted
## Logical input action names used across the project.
##
## Gameplay code must reference these constants rather than raw keys, touch
## buttons or gamepad indices. Bindings live in project.godot and are
## (re)generated by tools/configure_input_map.gd.

const MOVE_LEFT: StringName = &"move_left"
const MOVE_RIGHT: StringName = &"move_right"
const MOVE_UP: StringName = &"move_up"       # Jump (optional, post grounded movement)
const MOVE_DOWN: StringName = &"move_down"   # Crouch (optional, post grounded movement)
const ATTACK_LIGHT: StringName = &"attack_light"
const ATTACK_HEAVY: StringName = &"attack_heavy"
const ATTACK_KICK: StringName = &"attack_kick"
const BLOCK: StringName = &"block"
const SPECIAL: StringName = &"special"
const ULTIMATE: StringName = &"ultimate"
const PAUSE: StringName = &"pause"
const DEBUG_TOGGLE_OVERLAY: StringName = &"debug_toggle_overlay"

## Every gameplay action that must exist in the input map.
const ALL: Array[StringName] = [
	MOVE_LEFT, MOVE_RIGHT, MOVE_UP, MOVE_DOWN,
	ATTACK_LIGHT, ATTACK_HEAVY, ATTACK_KICK,
	BLOCK, SPECIAL, ULTIMATE,
	PAUSE, DEBUG_TOGGLE_OVERLAY,
]
